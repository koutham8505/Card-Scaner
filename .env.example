# ── Frontend (Next.js server only) ────────────────────────────────────────────
# Set distinct random values of at least 32 characters in the deployment secret store.
EVENTCONNECT_SESSION_SECRET=
EVENTCONNECT_API_URL=http://127.0.0.1:8000
EVENTCONNECT_API_TOKEN=
SUPABASE_URL=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_ENABLE_OFFLINE_CAPTURE=false
NEXT_PUBLIC_ENABLE_QR_REGISTRATION=false

# ── Backend (FastAPI) ─────────────────────────────────────────────────────────
# Set the same EVENTCONNECT_API_TOKEN as the Next.js server.
EVENTCONNECT_ENV=development
EVENTCONNECT_API_TOKEN=
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=eventconnect-cards
EVENTCONNECT_SUPABASE_STORAGE_ENABLED=false
EVENTCONNECT_QR_ENABLED=false
ZOHO_WRITE_ENABLED=false
GOOGLE_DRIVE_WRITE_ENABLED=false

# Google Drive service account (writes remain disabled until Shared Drive access is verified)
GOOGLE_DRIVE_CREDENTIALS_JSON=
GOOGLE_DRIVE_SHARED_DRIVE_ID=

# Zoho CRM metadata verification (writes remain disabled)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_MAPPING_APPROVED=false
